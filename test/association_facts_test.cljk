(ns association-facts-test
  (:require [kotoba.bytes :as kbytes] [clojure.java.io :as io] [kotoba.process :as shell]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler] [kotoba.kir :as ir]))
(def source (slurp "src/association_facts.kotoba"))
(defn call [kir f & xs] (ir/execute kir f (vec xs)))
(defn present [x] (when (second x) (nth x 2)))
(def fields ["id" "title" "association" "isic" "country" "kind" "url" "url-provenance"
             "established-date" "last-revised-date" "retrieved-at"])
(def expected
  [{"id" "vnba.founding-1994" "title" "VNBA founding (History)"
    "association" "vnba" "isic" "6419" "country" "VNM" "kind" "governance-program"
    "url" "https://vnba.org.vn/en/page/history.htm" "url-provenance" "official-vnba-org-vn"
    "established-date" "1994-05-14" "last-revised-date" nil "retrieved-at" "2026-07-16"}
   {"id" "vnba.asean-banking-association-join-1995"
    "title" "VNBA joins ASEAN Banking Association as 7th member (History)"
    "association" "vnba" "isic" "6419" "country" "VNM" "kind" "governance-program"
    "url" "https://vnba.org.vn/en/page/history.htm" "url-provenance" "official-vnba-org-vn"
    "established-date" "1995-09-29" "last-revised-date" nil "retrieved-at" "2026-07-16"}])
(deftest reference-preserves-authority
  (let [kir (:kir (compiler/compile-source source :js-kotoba-v1))
        observed (mapv (fn [i] (into {} (map (fn [f] [f (present (call kir 'entry-field "vnba" i f))]) fields))) [0 1])]
    (is (= expected observed))
    (is (= ["1994-05-14" "1995-09-29"] (mapv #(present (call kir 'entry-field "vnba" % "established-date")) [0 1])))
    (is (= [nil nil] (mapv #(present (call kir 'entry-field "vnba" % "last-revised-date")) [0 1])))
    (is (= [["governance"] ["governance"]]
           (mapv (fn [i] (mapv #(present (call kir 'topic "vnba" i %)) (range (call kir 'topic-count "vnba" i)))) [0 1])))
    (is (= ["vnba.founding-1994" "vnba.asean-banking-association-join-1995"]
           (mapv #(present (call kir 'by-topic-id "vnba" "governance" %)) [0 1])))
    (is (= #{} (set (:effects kir))))
    (testing "fail closed"
      (is (zero? (call kir 'entry-count "vietnam-banks-association")))
      (is (zero? (call kir 'entry-count "ubf")))
      (is (nil? (present (call kir 'entry-field "vnba" 2 "id"))))
      (is (nil? (present (call kir 'entry-field "vnba" 0 "last-revised-date"))))
      (is (nil? (present (call kir 'topic "vnba" 1 1))))
      (is (zero? (call kir 'by-topic-count "vnba" "labor")))
      (is (nil? (present (call kir 'by-topic-id "vnba" "governance" 2)))))))
(defn compiler-root [] (nth (iterate #(.getParent ^java.nio.file.Path %)
  (java.nio.file.Path/of (.toURI (io/resource "kotoba/compiler/core.clj")))) 4))
(defn base64 [x] (kbytes/base64-encode x))
(deftest restricted-js-and-wasm-conform-semantically
  (let [js (compiler/compile-source source :js-kotoba-v1) wasm (compiler/compile-source source :wasm32-browser-kotoba-v1)
        js64 (base64 (kbytes/utf8-bytes ^String (:source js))) wasm64 (base64 ^bytes (:bytes wasm))
        p (shell/sh "node" "--input-type=module" "-e"
            (str "import(process.argv[1]).then(async h=>{const j=await import('data:text/javascript;base64," js64 "');const w=await h.instantiateKotoba(Buffer.from(process.argv[2],'base64'));const r=x=>{if(x['entry-field']('vnba',0n,'established-date')[2]!=='1994-05-14'||x['entry-field']('vnba',1n,'established-date')[2]!=='1995-09-29'||x['entry-field']('vnba',0n,'last-revised-date')[1]!==false)throw Error('dates');if(x['by-topic-count']('vnba','governance')!==2n||x['by-topic-id']('vnba','governance',1n)[2]!=='vnba.asean-banking-association-join-1995'||x['entry-count']('vietnam-banks-association')!==0n||x['entry-count']('ubf')!==0n)throw Error('authority');};r(j.instantiateKotoba({}));r(w.instance.exports)}).catch(e=>{console.error(e);process.exit(99)})")
            (.toString (.toUri (.resolve (compiler-root) "runtime/browser-host.mjs"))) wasm64)]
    (is (zero? (:exit p)) (str (:out p) (:err p)))))
(deftest production-source-authority
  (is (= ["src/association_facts.kotoba"] (->> (file-seq (io/file "src")) (filter #(.isFile %)) (map str) sort vec))))
